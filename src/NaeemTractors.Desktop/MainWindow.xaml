<?xml version="1.0" ?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="NaeemTractors.Desktop.MainWindow" Title="Naeem Tractors · Inventory" Width="1440" Height="900" MinWidth="1150" MinHeight="720" WindowStartupLocation="CenterScreen" Loaded="Window_Loaded" PreviewKeyDown="Window_KeyDown" Closing="Window_Closing">


  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="34"/>
    </Grid.RowDefinitions>


    <Grid x:Name="Workspace">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="205"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>


      <Border Background="#222C23" Padding="16,26,16,18">
        <DockPanel>


          <StackPanel DockPanel.Dock="Top" Margin="8,0,0,28">
            <TextBlock Text="NT" FontSize="37" FontWeight="Bold" Foreground="#D9A441"/>
            <TextBlock Text="NAEEM TRACTORS" Foreground="White" FontWeight="Bold" FontSize="15" Margin="0,8,0,3"/>
            <TextBlock Text="SHOP MANAGEMENT" Foreground="#A8B7A4" FontSize="10"/>
          </StackPanel>


          <StackPanel DockPanel.Dock="Bottom" Margin="8,20,0,0">
            <TextBlock Text="●  LOCAL DATABASE" Foreground="#B3CD9E" FontSize="10"/>
            <TextBlock Text="Owner edition · v0.1" Foreground="#A8B7A4" FontSize="11" Margin="0,7,0,0"/>
          </StackPanel>


          <StackPanel>
            <Button x:Name="Nav0" Tag="0" Click="Navigate_Click" Style="{StaticResource Nav}" Content="◈   Overview"/>
            <Button x:Name="Nav1" Tag="1" Click="Navigate_Click" Style="{StaticResource Nav}" Content="▦   Products"/>
            <Button x:Name="Nav2" Tag="2" Click="Navigate_Click" Style="{StaticResource Nav}" Content="↗   Stock receipts"/>
            <Button x:Name="Nav3" Tag="3" Click="Navigate_Click" Style="{StaticResource Nav}" Content="＋   New sale"/>
            <Button x:Name="Nav4" Tag="4" Click="Navigate_Click" Style="{StaticResource Nav}" Content="▤   Invoices &amp; payments"/>
            <Button x:Name="Nav5" Tag="5" Click="Navigate_Click" Style="{StaticResource Nav}" Content="−   Expenses"/>
            <Button x:Name="Nav6" Tag="6" Click="Navigate_Click" Style="{StaticResource Nav}" Content="▥   Reports"/>
            <Button x:Name="Nav7" Tag="7" Click="Navigate_Click" Style="{StaticResource Nav}" Content="⚙   Settings"/>
          </StackPanel>


        </DockPanel>
      </Border>


      <Grid Grid.Column="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="60"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="26,0">
          <DockPanel>
            <TextBlock x:Name="CurrencyLabel" Text="PKR · OFFLINE READY" DockPanel.Dock="Right" Foreground="{StaticResource Muted}" FontSize="12"/>
            <TextBlock x:Name="ShopHeading" Text="Naeem Tractors" FontWeight="SemiBold" FontSize="16"/>
          </DockPanel>
        </Border>


        <TabControl x:Name="Pages" Grid.Row="1">
          <TabItem>
            <Grid Margin="26,20">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <StackPanel Grid.Row="0">
                <TextBlock Text="Your shop, at a glance" Style="{StaticResource Title}"/>
                <TextBlock Text="Today’s trading and the stock that needs attention." Style="{StaticResource Hint}"/>
              </StackPanel>
              <UniformGrid Grid.Row="1" Columns="4" Rows="2">
                <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                  <StackPanel>
                    <TextBlock Text="Sales today" Style="{StaticResource Label}"/>
                    <TextBlock x:Name="TodaySales" Text="—" FontSize="28" FontWeight="SemiBold" Margin="0,5,0,8"/>
                    <TextBlock Text="Invoice totals, including tax" Style="{StaticResource Hint}"/>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                  <StackPanel>
                    <TextBlock Text="Collections today" Style="{StaticResource Label}"/>
                    <TextBlock x:Name="TodayCollections" Text="—" FontSize="28" FontWeight="SemiBold" Margin="0,5,0,8"/>
                    <TextBlock Text="Payments received today" Style="{StaticResource Hint}"/>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                  <StackPanel>
                    <TextBlock Text="Customer dues" Style="{StaticResource Label}"/>
                    <TextBlock x:Name="Outstanding" Text="—" FontSize="28" FontWeight="SemiBold" Margin="0,5,0,8"/>
                    <TextBlock Text="All unpaid invoice balances" Style="{StaticResource Hint}"/>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                  <StackPanel>
                    <TextBlock Text="Stock value" Style="{StaticResource Label}"/>
                    <TextBlock x:Name="StockValue" Text="—" FontSize="28" FontWeight="SemiBold" Margin="0,5,0,8"/>
                    <TextBlock Text="At weighted-average cost" Style="{StaticResource Hint}"/>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                  <StackPanel>
                    <TextBlock Text="Active products" Style="{StaticResource Label}"/>
                    <TextBlock x:Name="ProductCount" Text="—" FontSize="28" FontWeight="SemiBold" Margin="0,5,0,8"/>
                    <TextBlock Text="Products available for sale" Style="{StaticResource Hint}"/>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                  <StackPanel>
                    <TextBlock Text="Low stock" Style="{StaticResource Label}"/>
                    <TextBlock x:Name="LowStockCount" Text="—" FontSize="28" FontWeight="SemiBold" Margin="0,5,0,8"/>
                    <TextBlock Text="At or below minimum level" Style="{StaticResource Hint}"/>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                  <StackPanel>
                    <TextBlock Text="Gross profit today" Style="{StaticResource Label}"/>
                    <TextBlock x:Name="TodayProfit" Text="—" FontSize="28" FontWeight="SemiBold" Margin="0,5,0,8"/>
                    <TextBlock Text="Sales less tax and item cost" Style="{StaticResource Hint}"/>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                  <StackPanel>
                    <TextBlock Text="Expenses today" Style="{StaticResource Label}"/>
                    <TextBlock x:Name="TodayExpenses" Text="—" FontSize="28" FontWeight="SemiBold" Margin="0,5,0,8"/>
                    <TextBlock Text="Recorded shop expenses" Style="{StaticResource Hint}"/>
                  </StackPanel>
                </Border>
              </UniformGrid>
              <Border Style="{StaticResource Card}" Grid.Row="2">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                  </Grid.RowDefinitions>
                  <DockPanel Margin="0,0,0,15">
                    <Button Content="Refresh · F5" Click="Refresh_Click" Style="{StaticResource Secondary}" DockPanel.Dock="Right"/>
                    <StackPanel>
                      <TextBlock Text="Restock attention"/>
                      <TextBlock Text="Active products at or below their minimum. Up to 500 items." Style="{StaticResource Hint}"/>
                    </StackPanel>
                  </DockPanel>
                  <DataGrid x:Name="LowStockGrid" Grid.Row="1">
                    <DataGrid.Columns>
                      <DataGridTextColumn Header="Part no." Binding="{Binding Sku}" Width="120"/>
                      <DataGridTextColumn Header="Product" Binding="{Binding Name}" Width="*" MinWidth="140"/>
                      <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="110"/>
                      <DataGridTextColumn Header="Stock" Binding="{Binding Stock, StringFormat=N0}" Width="70"/>
                      <DataGridTextColumn Header="Sell price" Binding="{Binding SellingPrice, StringFormat=N2}" Width="100"/>
                      <DataGridTextColumn Header="Status" Binding="{Binding StockStatus}" Width="100"/>
                    </DataGrid.Columns>
                  </DataGrid>
                </Grid>
              </Border>
            </Grid>
          </TabItem>
          <TabItem>
            <Grid Margin="26,20">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <StackPanel Grid.Row="0">
                <TextBlock Text="Products" Style="{StaticResource Title}"/>
                <TextBlock Text="Create your catalog first. Search by part number, name, brand, tractor model, or shelf." Style="{StaticResource Hint}"/>
              </StackPanel>
              <Grid Grid.Row="1" Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="150"/>
                  <ColumnDefinition Width="135"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="ProductSearch" TextChanged="ProductFilter_Changed" ToolTip="Search products · Ctrl+F" Margin="0,0,10,0" Tag="Search…"/>
                <ComboBox x:Name="CategoryFilter" Grid.Column="1" SelectionChanged="ProductFilter_Changed" Margin="0,0,10,0"/>
                <ComboBox x:Name="StockFilter" Grid.Column="2" SelectedIndex="0" SelectionChanged="ProductFilter_Changed" Margin="0,0,10,0">
                  <ComboBoxItem Content="Active"/>
                  <ComboBoxItem Content="All"/>
                  <ComboBoxItem Content="Low stock"/>
                  <ComboBoxItem Content="In stock"/>
                  <ComboBoxItem Content="Archived"/>
                </ComboBox>
                <Button Content="New product" Click="NewProduct_Click" Grid.Column="3"/>
              </Grid>
              <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="320"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Margin="0,0,16,0">
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="*"/>
                      <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DataGrid x:Name="ProductsGrid" SelectionChanged="Product_Selected">
                      <DataGrid.Columns>
                        <DataGridTextColumn Header="Part no." Binding="{Binding Sku}" Width="120"/>
                        <DataGridTextColumn Header="Product" Binding="{Binding Name}" Width="*" MinWidth="140"/>
                        <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="110"/>
                        <DataGridTextColumn Header="Stock" Binding="{Binding Stock, StringFormat=N0}" Width="70"/>
                        <DataGridTextColumn Header="Sell price" Binding="{Binding SellingPrice, StringFormat=N2}" Width="100"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding StockStatus}" Width="100"/>
                      </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="1" Text="Up to 500 matching products. Refine search to narrow results." Style="{StaticResource Hint}"/>
                  </Grid>
                </Border>
                <Border Style="{StaticResource Card}" Grid.Column="1">
                  <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                      <TextBlock Text="Product details"/>
                      <TextBlock Text="Select a row to edit, or choose New product." Style="{StaticResource Hint}"/>
                      <TextBlock Text="Part number *" Style="{StaticResource Label}"/>
                      <TextBox x:Name="ProductSku" Text=""/>
                      <TextBlock Text="Product name *" Style="{StaticResource Label}"/>
                      <TextBox x:Name="ProductName" Text=""/>
                      <TextBlock Text="Category" Style="{StaticResource Label}"/>
                      <TextBox x:Name="ProductCategory" Text=""/>
                      <TextBlock Text="Brand" Style="{StaticResource Label}"/>
                      <TextBox x:Name="ProductBrand" Text=""/>
                      <TextBlock Text="Compatible tractor models" Style="{StaticResource Label}"/>
                      <TextBox x:Name="ProductModel" Text=""/>
                      <TextBlock Text="Unit * (whole quantities)" Style="{StaticResource Label}"/>
                      <TextBox x:Name="ProductUnit" Text="piece"/>
                      <TextBlock Text="Shelf / bin location" Style="{StaticResource Label}"/>
                      <TextBox x:Name="ProductLocation" Text=""/>
                      <TextBlock Text="Selling price *" Style="{StaticResource Label}"/>
                      <TextBox x:Name="ProductPrice" Text="0.00"/>
                      <TextBlock Text="Minimum stock *" Style="{StaticResource Label}"/>
                      <TextBox x:Name="ProductMinimum" Text="5"/>
                      <CheckBox x:Name="ProductActive" Content="Active product" IsChecked="True" Margin="0,14,0,16"/>
                      <Button Content="Save product · Ctrl+S" Click="SaveProduct_Click"/>
                    </StackPanel>
                  </ScrollViewer>
                </Border>
              </Grid>
            </Grid>
          </TabItem>
          <TabItem>
            <Grid Margin="26,20">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <StackPanel Grid.Row="0">
                <TextBlock Text="Stock receipts &amp; history" Style="{StaticResource Title}"/>
                <TextBlock Text="Every stock change has a source. Sales deduct stock automatically." Style="{StaticResource Hint}"/>
              </StackPanel>
              <Grid Grid.Row="1" Grid.RowSpan="2">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="330"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Margin="0,0,16,0">
                  <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                      <TextBlock Text="Receive stock"/>
                      <TextBlock Text="Find product" Style="{StaticResource Label}"/>
                      <TextBox x:Name="StockProductSearch" Text="" TextChanged="StockSearch_Changed" Tag="Search…"/>
                      <TextBlock Text="Product *" Style="{StaticResource Label}"/>
                      <ComboBox x:Name="StockProduct" DisplayMemberPath="Display"/>
                      <TextBlock Text="Receipt type" Style="{StaticResource Label}"/>
                      <ComboBox x:Name="StockKind" SelectedIndex="0">
                        <ComboBoxItem Content="Opening stock"/>
                        <ComboBoxItem Content="Purchase"/>
                      </ComboBox>
                      <TextBlock Text="Quantity *" Style="{StaticResource Label}"/>
                      <TextBox x:Name="StockQuantity" Text="1"/>
                      <TextBlock Text="Cost per unit *" Style="{StaticResource Label}"/>
                      <TextBox x:Name="StockCost" Text="0.00"/>
                      <TextBlock Text="Supplier (required for purchase)" Style="{StaticResource Label}"/>
                      <TextBox x:Name="StockSupplier" Text=""/>
                      <TextBlock Text="Supplier invoice / reference" Style="{StaticResource Label}"/>
                      <TextBox x:Name="StockReference" Text=""/>
                      <TextBlock Text="Notes" Style="{StaticResource Label}"/>
                      <TextBox x:Name="StockNotes" Text=""/>
                      <TextBlock Text="Opening stock is allowed only before the first movement. Purchases update weighted-average cost. Supplier payment balances are not tracked in this version." Style="{StaticResource Hint}"/>
                      <Button Content="Post stock receipt" Click="ReceiveStock_Click"/>
                    </StackPanel>
                  </ScrollViewer>
                </Border>
                <Border Style="{StaticResource Card}" Grid.Column="1">
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="*"/>
                      <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBox x:Name="MovementSearch" TextChanged="MovementSearch_Changed" ToolTip="Search product, supplier, or reference" Margin="0,0,0,12" Tag="Search…"/>
                    <DataGrid x:Name="MovementsGrid" Grid.Row="1">
                      <DataGrid.Columns>
                        <DataGridTextColumn Header="Date" Binding="{Binding CreatedAt, StringFormat=dd MMM yy HH:mm}" Width="140"/>
                        <DataGridTextColumn Header="Part no." Binding="{Binding Sku}" Width="110"/>
                        <DataGridTextColumn Header="Product" Binding="{Binding Product}" Width="*" MinWidth="140"/>
                        <DataGridTextColumn Header="Qty +/−" Binding="{Binding Quantity, StringFormat=N0}" Width="85"/>
                        <DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="110"/>
                        <DataGridTextColumn Header="Unit cost" Binding="{Binding UnitCost, StringFormat=N2}" Width="95"/>
                        <DataGridTextColumn Header="Reference" Binding="{Binding Reference}" Width="120"/>
                        <DataGridTextColumn Header="Supplier" Binding="{Binding Supplier}" Width="120"/>
                        <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="160"/>
                      </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="2" Text="Latest 500 matching movements. Negative quantities are sales." Style="{StaticResource Hint}"/>
                  </Grid>
                </Border>
              </Grid>
            </Grid>
          </TabItem>
          <TabItem>
            <Grid Margin="26,20">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <StackPanel Grid.Row="0">
                <TextBlock Text="New sales invoice" Style="{StaticResource Title}"/>
                <TextBlock Text="Search parts, build the invoice, and record a full or partial payment." Style="{StaticResource Hint}"/>
              </StackPanel>
              <Grid Grid.Row="1" Grid.RowSpan="2">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="300"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Margin="0,0,16,0">
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="*"/>
                      <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBox x:Name="SaleSearch" TextChanged="SaleSearch_Changed" ToolTip="Search products" Margin="0,0,0,8" Tag="Search…"/>
                    <StackPanel Grid.Row="1">
                      <TextBlock Text="Find and add an item" Style="{StaticResource Label}"/>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="85"/>
                          <ColumnDefinition Width="110"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="SaleProduct" DisplayMemberPath="Display" SelectionChanged="SaleProduct_Selected" Margin="0,0,8,0"/>
                        <TextBox x:Name="SaleQuantity" Text="1" ToolTip="Quantity" Grid.Column="1" Margin="0,0,8,0"/>
                        <TextBox x:Name="SaleUnitPrice" Text="0.00" ToolTip="Unit price" Grid.Column="2" Margin="0,0,8,0"/>
                        <Button Content="Add item" Click="AddSaleLine_Click" Grid.Column="3"/>
                      </Grid>
                    </StackPanel>
                    <DataGrid x:Name="CartGrid" Grid.Row="2" Margin="0,16,0,12">
                      <DataGrid.Columns>
                        <DataGridTextColumn Header="Part no." Binding="{Binding Sku}" Width="110"/>
                        <DataGridTextColumn Header="Product" Binding="{Binding Name}" Width="*" MinWidth="140"/>
                        <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity, StringFormat=N0}" Width="85"/>
                        <DataGridTextColumn Header="Unit price" Binding="{Binding UnitPrice, StringFormat=N2}" Width="100"/>
                        <DataGridTextColumn Header="Amount" Binding="{Binding Total, StringFormat=N2}" Width="110"/>
                      </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="3" Orientation="Horizontal">
                      <Button Content="Remove selected" Click="RemoveSaleLine_Click" Style="{StaticResource Secondary}"/>
                      <Button Content="Clear draft" Click="ClearSale_Click" Style="{StaticResource Secondary}"/>
                    </StackPanel>
                  </Grid>
                </Border>
                <Border Style="{StaticResource Card}" Grid.Column="1">
                  <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                      <TextBlock Text="Customer &amp; totals"/>
                      <TextBlock Text="Customer (required for credit)" Style="{StaticResource Label}"/>
                      <TextBox x:Name="SaleCustomer" Text=""/>
                      <TextBlock Text="Phone" Style="{StaticResource Label}"/>
                      <TextBox x:Name="SalePhone" Text=""/>
                      <TextBlock Text="Discount amount" Style="{StaticResource Label}"/>
                      <TextBox x:Name="SaleDiscount" Text="0.00" TextChanged="SaleTotals_Changed"/>
                      <TextBlock Text="Tax % (confirm local requirements)" Style="{StaticResource Label}"/>
                      <TextBox x:Name="SaleTax" Text="0" TextChanged="SaleTotals_Changed"/>
                      <TextBlock Text="Payment received now" Style="{StaticResource Label}"/>
                      <TextBox x:Name="SalePaid" Text="0.00" TextChanged="SaleTotals_Changed"/>
                      <TextBlock Text="Payment method" Style="{StaticResource Label}"/>
                      <ComboBox x:Name="SaleMethod" SelectedIndex="0">
                        <ComboBoxItem Content="Cash"/>
                        <ComboBoxItem Content="Bank"/>
                        <ComboBoxItem Content="Easypaisa"/>
                        <ComboBoxItem Content="JazzCash"/>
                      </ComboBox>
                      <TextBlock Text="Notes" Style="{StaticResource Label}"/>
                      <TextBox x:Name="SaleNotes" Text=""/>
                      <Border Background="{StaticResource GreenLight}" CornerRadius="8" Padding="14" Margin="0,16,0,12">
                        <StackPanel>
                          <TextBlock Text="Invoice summary" Style="{StaticResource Label}"/>
                          <TextBlock Text="Subtotal  0.00" x:Name="CartSubtotal"/>
                          <TextBlock Text="Tax  0.00" x:Name="CartTax"/>
                          <TextBlock x:Name="CartTotal" Text="Total  0.00" FontSize="24" FontWeight="SemiBold" Margin="0,8"/>
                          <TextBlock Text="Due  0.00" x:Name="CartDue"/>
                        </StackPanel>
                      </Border>
                      <Button Content="Pay full amount" Click="PayFull_Click" Style="{StaticResource Secondary}" Margin="0,0,8,10"/>
                      <Button Content="Post invoice · Ctrl+Enter" Click="PostSale_Click"/>
                      <TextBlock Text="Posting finalizes the invoice and stock. Check quantities and prices first." Style="{StaticResource Hint}"/>
                    </StackPanel>
                  </ScrollViewer>
                </Border>
              </Grid>
            </Grid>
          </TabItem>
          <TabItem>
            <Grid Margin="26,20">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <StackPanel Grid.Row="0">
                <TextBlock Text="Invoices &amp; payments" Style="{StaticResource Title}"/>
                <TextBlock Text="Find an invoice, check its balance, collect a payment, or print a copy." Style="{StaticResource Hint}"/>
              </StackPanel>
              <DockPanel Grid.Row="1" Margin="0,0,0,15">
                <CheckBox x:Name="OnlyOutstanding" Content="Outstanding only" DockPanel.Dock="Right" Checked="InvoiceFilter_Changed" Unchecked="InvoiceFilter_Changed" Margin="12,0,0,0"/>
                <TextBox x:Name="InvoiceSearch" TextChanged="InvoiceFilter_Changed" ToolTip="Search invoice number, customer, or phone" Tag="Search…"/>
              </DockPanel>
              <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="290"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Margin="0,0,16,0">
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="3*"/>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="2*"/>
                    </Grid.RowDefinitions>
                    <DataGrid x:Name="InvoicesGrid" SelectionChanged="Invoice_Selected">
                      <DataGrid.Columns>
                        <DataGridTextColumn Header="Invoice" Binding="{Binding Number}" Width="110"/>
                        <DataGridTextColumn Header="Date" Binding="{Binding CreatedAt, StringFormat=dd MMM yy HH:mm}" Width="140"/>
                        <DataGridTextColumn Header="Customer" Binding="{Binding Customer}" Width="*" MinWidth="140"/>
                        <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=N2}" Width="110"/>
                        <DataGridTextColumn Header="Paid" Binding="{Binding Paid, StringFormat=N2}" Width="100"/>
                        <DataGridTextColumn Header="Due" Binding="{Binding Balance, StringFormat=N2}" Width="100"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="85"/>
                      </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="1" Text="Payment history · latest 500 matching payments" Style="{StaticResource Label}"/>
                    <DataGrid x:Name="PaymentsGrid" Grid.Row="2">
                      <DataGrid.Columns>
                        <DataGridTextColumn Header="Date" Binding="{Binding CreatedAt, StringFormat=dd MMM yy HH:mm}" Width="140"/>
                        <DataGridTextColumn Header="Invoice" Binding="{Binding InvoiceNumber}" Width="110"/>
                        <DataGridTextColumn Header="Customer" Binding="{Binding Customer}" Width="*" MinWidth="140"/>
                        <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat=N2}" Width="100"/>
                        <DataGridTextColumn Header="Method" Binding="{Binding Method}" Width="100"/>
                        <DataGridTextColumn Header="Reference" Binding="{Binding Reference}" Width="130"/>
                      </DataGrid.Columns>
                    </DataGrid>
                  </Grid>
                </Border>
                <Border Style="{StaticResource Card}" Grid.Column="1">
                  <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                      <TextBlock Text="Collect a payment"/>
                      <TextBlock Text="Select an invoice from the table." Style="{StaticResource Hint}"/>
                      <TextBlock Text="No invoice selected" x:Name="PaymentInvoice"/>
                      <TextBlock Text="Amount received *" Style="{StaticResource Label}"/>
                      <TextBox x:Name="PaymentAmount" Text=""/>
                      <TextBlock Text="Method" Style="{StaticResource Label}"/>
                      <ComboBox x:Name="PaymentMethod" SelectedIndex="0">
                        <ComboBoxItem Content="Cash"/>
                        <ComboBoxItem Content="Bank"/>
                        <ComboBoxItem Content="Easypaisa"/>
                        <ComboBoxItem Content="JazzCash"/>
                      </ComboBox>
                      <TextBlock Text="Payment reference / note" Style="{StaticResource Label}"/>
                      <TextBox x:Name="PaymentReference" Text=""/>
                      <StackPanel Margin="0,16,0,12">
                        <Button Content="Record payment" Click="RecordPayment_Click"/>
                      </StackPanel>
                      <Button Content="View / print invoice" Click="PrintInvoice_Click" Style="{StaticResource Secondary}"/>
                      <TextBlock Text="Posted invoices are read-only. Returns and cancellations are not available in this version." Style="{StaticResource Hint}"/>
                    </StackPanel>
                  </ScrollViewer>
                </Border>
              </Grid>
            </Grid>
          </TabItem>
          <TabItem>
            <Grid Margin="26,20">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <StackPanel Grid.Row="0">
                <TextBlock Text="Shop expenses" Style="{StaticResource Title}"/>
                <TextBlock Text="Track operating costs separately from purchases and customer payments." Style="{StaticResource Hint}"/>
              </StackPanel>
              <Grid Grid.Row="1" Grid.RowSpan="2">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="320"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Margin="0,0,16,0">
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBox x:Name="ExpenseSearch" TextChanged="ExpenseSearch_Changed" ToolTip="Search expense category or description" Margin="0,0,0,12" Tag="Search…"/>
                    <DataGrid x:Name="ExpensesGrid" Grid.Row="1">
                      <DataGrid.Columns>
                        <DataGridTextColumn Header="Date" Binding="{Binding CreatedAt, StringFormat=dd MMM yy HH:mm}" Width="150"/>
                        <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="140"/>
                        <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" MinWidth="140"/>
                        <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat=N2}" Width="120"/>
                      </DataGrid.Columns>
                    </DataGrid>
                  </Grid>
                </Border>
                <Border Style="{StaticResource Card}" Grid.Column="1">
                  <StackPanel>
                    <TextBlock Text="Record shop expense"/>
                    <TextBlock Text="Category *" Style="{StaticResource Label}"/>
                    <TextBox x:Name="ExpenseCategory" Text=""/>
                    <TextBlock Text="Description *" Style="{StaticResource Label}"/>
                    <TextBox x:Name="ExpenseDescription" Text=""/>
                    <TextBlock Text="Amount *" Style="{StaticResource Label}"/>
                    <TextBox x:Name="ExpenseAmount" Text=""/>
                    <StackPanel Margin="0,16,0,0">
                      <Button Content="Record expense" Click="AddExpense_Click"/>
                    </StackPanel>
                  </StackPanel>
                </Border>
              </Grid>
            </Grid>
          </TabItem>
          <TabItem>
            <Grid Margin="26,20">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <StackPanel Grid.Row="0">
                <TextBlock Text="Owner reports" Style="{StaticResource Title}"/>
                <TextBlock Text="Sales, collections, cost, and expenses stay separate so you can see how the shop is doing." Style="{StaticResource Hint}"/>
              </StackPanel>
              <WrapPanel Grid.Row="1" Margin="0,0,0,16">
                <TextBlock Text="From" Margin="0,0,8,0"/>
                <DatePicker x:Name="ReportFrom" Width="135" Margin="0,0,12,0"/>
                <TextBlock Text="Through" Margin="0,0,8,0"/>
                <DatePicker x:Name="ReportTo" Width="135" Margin="0,0,12,0"/>
                <Button Content="Apply dates" Click="RunReport_Click"/>
                <Button Content="Export sales CSV" Click="ExportSales_Click" Style="{StaticResource Secondary}"/>
                <Button Content="Export stock CSV" Click="ExportStock_Click" Style="{StaticResource Secondary}"/>
              </WrapPanel>
              <Border Style="{StaticResource Card}" Grid.Row="2">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                  </Grid.RowDefinitions>
                  <TextBlock x:Name="ReportSummary" TextWrapping="Wrap" FontSize="17" LineHeight="30"/>
                  <TextBlock Grid.Row="1" Margin="0,15,0,15" Text="Summary totals and CSV exports include all matching records. The table shows the latest 500 invoices. Operating result excludes unrecorded costs and supplier dues." Style="{StaticResource Hint}"/>
                  <DataGrid x:Name="ReportInvoicesGrid" Grid.Row="2">
                    <DataGrid.Columns>
                      <DataGridTextColumn Header="Invoice" Binding="{Binding Number}" Width="110"/>
                      <DataGridTextColumn Header="Date" Binding="{Binding CreatedAt, StringFormat=dd MMM yy HH:mm}" Width="140"/>
                      <DataGridTextColumn Header="Customer" Binding="{Binding Customer}" Width="*" MinWidth="140"/>
                      <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=N2}" Width="110"/>
                      <DataGridTextColumn Header="Paid" Binding="{Binding Paid, StringFormat=N2}" Width="100"/>
                      <DataGridTextColumn Header="Due" Binding="{Binding Balance, StringFormat=N2}" Width="100"/>
                      <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="85"/>
                    </DataGrid.Columns>
                  </DataGrid>
                </Grid>
              </Border>
            </Grid>
          </TabItem>
          <TabItem>
            <Grid Margin="26,20">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <StackPanel Grid.Row="0">
                <TextBlock Text="Settings &amp; backup" Style="{StaticResource Title}"/>
                <TextBlock Text="Your data stays on this computer. Keep an external backup as well." Style="{StaticResource Hint}"/>
              </StackPanel>
              <Grid Grid.Row="1" Grid.RowSpan="2">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Margin="0,0,16,0" VerticalAlignment="Top">
                  <StackPanel>
                    <TextBlock Text="Shop profile"/>
                    <TextBlock Text="Shop name *" Style="{StaticResource Label}"/>
                    <TextBox x:Name="ShopName" Text=""/>
                    <TextBlock Text="Phone" Style="{StaticResource Label}"/>
                    <TextBox x:Name="ShopPhone" Text=""/>
                    <TextBlock Text="Address" Style="{StaticResource Label}"/>
                    <TextBox x:Name="ShopAddress" Text="" AcceptsReturn="True" Height="75" TextWrapping="Wrap"/>
                    <TextBlock Text="Currency label *" Style="{StaticResource Label}"/>
                    <TextBox x:Name="ShopCurrency" Text="PKR"/>
                    <TextBlock Text="Currency is a display label. Changing it does not convert existing amounts. Phone and address are left blank until verified." Style="{StaticResource Hint}"/>
                    <Button Content="Save shop profile" Click="SaveSettings_Click"/>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Grid.Column="1" VerticalAlignment="Top">
                  <StackPanel>
                    <TextBlock Text="Protect your shop records"/>
                    <TextBlock Text="A daily snapshot is created when the app starts. Use Backup now before major changes, and copy backups to an external drive." Style="{StaticResource Hint}"/>
                    <Button Content="Backup now…" Click="Backup_Click"/>
                    <TextBlock Text="Database location" Style="{StaticResource Label}"/>
                    <TextBox x:Name="DatabaseLocation" IsReadOnly="True" TextWrapping="Wrap"/>
                    <TextBlock Text="Restore safely" Style="{StaticResource Label}"/>
                    <TextBlock Text="Close the app. Preserve the current data folder, then restore a verified backup as inventory.db. Detailed steps are in the README." Style="{StaticResource Hint}"/>
                    <TextBlock Text="Version 0.1 · local owner edition" Style="{StaticResource Label}"/>
                    <TextBlock Text="This version has no staff login, mobile synchronization, returns, supplier accounts, or tax compliance certification. Restrict computer access to the owner." Style="{StaticResource Hint}"/>
                  </StackPanel>
                </Border>
              </Grid>
            </Grid>
          </TabItem>
        </TabControl>


      </Grid>


    </Grid>


    <Border Grid.Row="1" Background="#E9EDE3" Padding="16,0">
      <DockPanel>
        <TextBlock Text="F5 Refresh    Ctrl+F Search    Ctrl+N New sale" DockPanel.Dock="Right" FontSize="11" Foreground="{StaticResource Muted}"/>
        <TextBlock x:Name="StatusText" Text="Starting your shop workspace…" FontSize="12" TextTrimming="CharacterEllipsis"/>
      </DockPanel>
    </Border>


  </Grid>


</Window>
